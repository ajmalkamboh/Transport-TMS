# ==============================================================================
# Goods Transport Management System (TMS) - Production Environment Configuration
# ==============================================================================

APP_NAME="Transport TMS"
APP_ENV=production
APP_KEY=base64:GENERATE_VIA_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://tms.yourdomain.com
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logging Configuration
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Database Configuration (MySQL / MariaDB with strict UTF8mb4)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tms_production
DB_USERNAME=tms_dbuser
DB_PASSWORD="SECURE_DATABASE_PASSWORD_HERE"

# Cache, Session & Queue Configuration (Redis for high-throughput scaling)
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Redis Cluster / Standalone Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Dispatch Engine (SMTP with TLS encryption)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@tms.yourdomain.com
MAIL_PASSWORD="SECURE_SMTP_PASSWORD"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="TMS Fleet Notifications"

# External GPS Providers & Telemetry Ingestion
GPS_DEFAULT_PROVIDER=traccar
TRACCAR_API_URL=https://gps.yourdomain.com/api
TRACCAR_API_KEY="SECURE_TRACCAR_KEY"
TELTONIKA_SERVER_PORT=5027

# SMS & WhatsApp Integration
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Automated Disaster Recovery Backups
BACKUP_DISK=local
BACKUP_RETENTION_DAYS=30

